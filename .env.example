# Variables de entorno de ejemplo para el sistema IoT Fragaria
# Copia este archivo como .env y completa los valores reales:

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=tucorreo@ejemplo.com

# Base de Datos PostgreSQL Supabase (Connection Pooler IPv4)
DB_HOST=aws-0-ca-central-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.[PROJECT_REF]
DB_PASSWORD=

